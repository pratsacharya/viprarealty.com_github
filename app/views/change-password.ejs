<% pageTitle = 'Change password' %>
<%- include('partials/header') %>
<h1>Change password</h1>
<% if (msg) { %><p class="note ok"><%= msg %></p><% } %>
<% if (error) { %><p class="note err"><%= error %></p><% } %>
<% if (user.must_change_password) { %><p class="note err">You must set a new password before continuing.</p><% } %>
<form method="post" action="/adminvr/change-password" style="max-width:420px">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <label>New password<input type="password" name="new" required></label>
  <label>Confirm new password<input type="password" name="confirm" required></label>
  <button class="btn" type="submit">Update password</button>
</form>
<%- include('partials/footer') %>
