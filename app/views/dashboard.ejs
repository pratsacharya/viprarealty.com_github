<% pageTitle = 'Dashboard' %>
<%- include('partials/header') %>
<h1>Dashboard</h1>
<div class="cards">
  <% Object.entries(counts).forEach(([label, n]) => { %>
    <div class="card"><div class="n"><%= n %></div><div class="l"><%= label %></div></div>
  <% }) %>
</div>

<h2>Listings by category</h2>
<table><tr><th>Category</th><th>Listings</th></tr>
<% byCat.forEach(r => { %><tr><td><%= r.name %></td><td><%= r.n %></td></tr><% }) %>
</table>

<h2>Top properties by enquiries</h2>
<table><tr><th>Property</th><th>Enquiries</th></tr>
<% if (!top.length) { %><tr><td class="muted" colspan="2">No verified enquiries yet.</td></tr><% } %>
<% top.forEach(r => { %><tr><td><%= ((r.project_title||'')+' '+(r.building_name||'')).trim() %></td><td><%= r.n %></td></tr><% }) %>
</table>
<%- include('partials/footer') %>
