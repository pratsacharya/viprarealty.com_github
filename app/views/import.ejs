<% pageTitle = 'Import' %>
<%- include('partials/header') %>
<h1>Bulk import listings (CSV)</h1>
<p class="muted">Open the Excel import template, choose <em>File → Save As → CSV</em>, then upload that CSV here. Columns are matched by header name; Category / Sub-category match the seeded lists; Status accepts Active / Inactive / Sold out / Rented out.</p>
<% if (report) { %>
  <% if (report.err) { %>
    <p class="note err"><%= report.err %></p>
  <% } else { %>
    <p class="note ok">Imported <%= report.ok %> of <%= report.total %> rows. Failed: <%= report.fail %>.</p>
    <% if (report.errors && report.errors.length) { %><pre class="note err" style="white-space:pre-wrap"><%= report.errors.join('\n') %></pre><% } %>
  <% } %>
<% } %>
<form method="post" action="/admin/import" enctype="multipart/form-data" style="max-width:480px">
  <input type="hidden" name="csrf" value="<%= csrf %>">
  <label>CSV file<input type="file" name="csv" accept=".csv,text/csv" required></label>
  <button class="btn" type="submit" style="margin-top:14px">Import</button>
</form>
<%- include('partials/footer') %>
