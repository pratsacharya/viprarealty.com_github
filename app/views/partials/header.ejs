<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin' %> — <%= SITE_NAME %></title>
<link rel="stylesheet" href="/public/admin.css">
</head>
<body>
<header class="topbar">
  <div class="brand"><%= SITE_NAME %> · Admin</div>
  <nav>
    <a href="/adminvr/dashboard" class="<%= page === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <a href="/adminvr/properties" class="<%= page === 'properties' ? 'active' : '' %>">Properties</a>
    <a href="/adminvr/property-edit" class="<%= page === 'property-edit' ? 'active' : '' %>">Add property</a>
    <% if (user.role === 'master') { %>
      <a href="/adminvr/import" class="<%= page === 'import' ? 'active' : '' %>">Import</a>
      <a href="/adminvr/enquiries" class="<%= page === 'enquiries' ? 'active' : '' %>">Enquiries</a>
      <a href="/adminvr/users" class="<%= page === 'users' ? 'active' : '' %>">Users</a>
    <% } %>
    <a href="/adminvr/change-password" class="<%= page === 'change-password' ? 'active' : '' %>">Password</a>
  </nav>
  <div class="who"><%= user.email %> (<%= user.role %>) · <a href="/adminvr/logout">Log out</a></div>
</header>
<main class="wrap">
