<% pageTitle = 'Properties' %>
<%- include('partials/header') %>
<h1>Properties <a class="btn sm" href="/adminvr/property-edit" style="float:right">+ Add property</a></h1>
<table>
  <tr><th>Title</th><th>Type</th><th>City</th><th>Price</th><th>Status</th><th>Featured</th><th>Actions</th></tr>
  <% if (!rows.length) { %><tr><td class="muted" colspan="7">No listings yet.</td></tr><% } %>
  <% rows.forEach(p => { const b = '/adminvr/properties/' + p.id; %>
    <tr>
      <td><%= ((p.project_title||'')+' '+(p.building_name||'')).trim() || '—' %>
          <div class="muted"><%= p.cat || '' %><%= p.subcat ? (' · ' + p.subcat) : '' %></div></td>
      <td><%= p.search_type %><% if (p.listing_type) { %><br><span class="muted"><%= p.listing_type %></span><% } %></td>
      <td><%= p.city || '' %></td>
      <td><% if (p.search_type === 'Buy') { %><%= p.sale_price ? '₹' + Number(p.sale_price).toLocaleString('en-IN') : '—' %><% } else { %><%= p.monthly_rent ? '₹' + Number(p.monthly_rent).toLocaleString('en-IN') + '/mo' : '—' %><% } %></td>
      <td><span class="badge b-<%= p.status %>"><%= p.status.replace('_',' ').toUpperCase() %></span></td>
      <td><%= p.featured ? 'Yes' : '—' %></td>
      <td class="actions">
        <a class="btn sm ghost" href="/adminvr/property-edit?id=<%= p.id %>">Edit</a>
        <% if (user.role === 'master') { %>
          <% if (p.status !== 'active') { %><a class="btn sm" href="<%= b %>/status?status=active&csrf=<%= csrf %>">Activate</a><% } %>
          <% if (p.status !== 'inactive') { %><a class="btn sm ghost" href="<%= b %>/status?status=inactive&csrf=<%= csrf %>">Inactive</a><% } %>
          <a class="btn sm ghost" href="<%= b %>/status?status=sold_out&csrf=<%= csrf %>">Sold</a>
          <a class="btn sm ghost" href="<%= b %>/status?status=rented_out&csrf=<%= csrf %>">Rented</a>
          <a class="btn sm ghost" href="<%= b %>/feature?csrf=<%= csrf %>"><%= p.featured ? 'Unfeature' : 'Feature' %></a>
          <a class="btn sm danger" href="<%= b %>/delete?csrf=<%= csrf %>" onclick="return confirm('Delete this listing?')">Delete</a>
        <% } %>
      </td>
    </tr>
  <% }) %>
</table>
<% if (user.role !== 'master') { %><p class="muted">You can add listings. Status changes and delete are master-only.</p><% } %>
<%- include('partials/footer') %>
